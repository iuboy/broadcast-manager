# Broadcast Service 环境变量配置模板
#
# 复制此文件为 .env 并根据需要修改配置
# 注意：此文件仅用于开发环境，生产环境使用 TOML 配置文件

# ===== 服务器配置 =====
# 监听地址（0.0.0.0 表示所有网络接口）
BROADCAST_BIND_ADDRESS=0.0.0.0

# 服务端口
BROADCAST_PORT=8081

# 最大连接数
BROADCAST_MAX_CONNECTIONS=10

# ===== 日志配置 =====
# 日志级别：trace, debug, info, warn, error
RUST_LOG=info

# ===== 安全配置 =====
# 启用客户端白名单（true/false）
BROADCAST_WHITELIST_ENABLED=false

# 允许的客户端 IP 地址（逗号分隔）
# BROADCAST_WHITELIST_ADDRESSES=192.168.1.100,192.168.1.101

# ===== 音频配置 =====
# 默认采样率
BROADCAST_SAMPLE_RATE=44100

# 默认声道数（1=单声道，2=立体声）
BROADCAST_CHANNELS=1

# 默认编解码格式（pcm, opus）
BROADCAST_CODEC=pcm

# ===== 开发选项 =====
# Tauri 开发主机（仅开发模式）
TAURI_DEV_HOST= localhost

# 是否启用自动启动（true/false）
BROADCAST_AUTOSTART=false
